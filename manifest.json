{
  "manifest_version": 3,
  "name": "Stream Study — Public Chat Notebook",
  "version": "0.2.0",
  "description": "Study loaded YouTube live and replay chat, with observed Super Chat and Super Sticker purchases saved locally.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Open Stream Study"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["core.js", "content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
